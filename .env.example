# Copy this file to .env and fill in your own key. Never commit .env.
# Get a key from Google Cloud Console, enable "YouTube Data API v3",
# and restrict it to your Android package name + SHA-1 certificate fingerprint.
EXPO_PUBLIC_YOUTUBE_API_KEY=

# Optional. Base URL of the ISAIYA Search API (see server/). This is just an
# address, not a secret. If unset, the Search Agent (autocomplete + query
# intent understanding) is unavailable and search falls back to exactly
# today's deterministic behavior — the app works fine either way.
# For local dev with a physical phone in Expo Go, use your machine's LAN IP:
EXPO_PUBLIC_SEARCH_AGENT_URL=
