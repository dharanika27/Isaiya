# Copy this file to .env. Never commit the real .env.

PORT=4000

# rule-based needs no key and is the only implemented provider today.
# Setting this to anything else currently just logs a warning and falls
# back to rule-based (see src/agent/provider.ts) until a real provider is
# implemented there.
LLM_PROVIDER=rule-based

# Reserved for when a real LLM provider is wired in. Not used yet.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
