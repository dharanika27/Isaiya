# Copy this file to .env. Never commit the real .env — and NEVER put the
# Gemini key (or any LLM key) in the Expo app's .env / EXPO_PUBLIC_* vars.
# It must exist only here, on the backend.

PORT=4000

# "rule-based" (default) needs no key and runs entirely locally.
# "gemini" uses GeminiProvider (src/agent/geminiProvider.ts); if
# GEMINI_API_KEY is unset, it silently falls back to rule-based (see
# src/agent/provider.ts) rather than failing to start.
LLM_PROVIDER=rule-based

# Required only when LLM_PROVIDER=gemini. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to "gemini-flash-latest" (a rolling alias for Google's
# current recommended fast/cheap model) if unset.
GEMINI_MODEL=gemini-flash-latest

# Reserved for other providers, not implemented yet.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
